# Browser-visible values. Use a publishable key, NEVER a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://gattldfwkbvkxodshzwb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Use the deployed HTTPS origin in production/preview.
APP_URL=http://localhost:3000
SOURCE_SIGNED_URL_TTL_SECONDS=60

# Optional: background workers only. Not needed for authenticated file downloads.
# Store a real value in the hosting secret store or ignored .env.local.
SUPABASE_SECRET_KEY=

# External SMTP is configured separately in Supabase Auth, not by Next.js.
# See .env.smtp.example and docs/environments.md.
